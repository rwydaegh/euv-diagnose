{
  "name": "euv-diagnose-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "format": "prettier --write src data-contract.ts index.html vite.config.ts eslint.config.js tsconfig.json",
    "format:check": "prettier --check src data-contract.ts index.html vite.config.ts eslint.config.js tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
